# Datos crudos: 79 MB de velas descargadas, se regeneran con Entrenar.bat
bot/datos/

# Productos del entrenamiento (modelos, curvas, trades simulados): 13 MB
bot/resultados/

# Copias de seguridad locales
_respaldo*/

# Estado y salidas de ejecución
*.log
__pycache__/
*.pyc
bot/estado_cerebro.json
bot/asistente_estado.json
bot/avisos_estado.json
bot/avisos_pendientes.txt
bot/contador_dia.json

# El cuaderno y el registro son la contabilidad de tus decisiones: tuya, no del repo
cuaderno.csv
bot/decisiones.csv

# CREDENCIALES — nunca van al repositorio
bot/claves.json
bot/telegram.json
*.env
.env*

# Plantillas con placeholders: esas sí pueden ir
!bot/claves.EJEMPLO.json
!bot/telegram.EJEMPLO.json
!bot/noticias.EJEMPLO.json

# Noticias: el cache se regenera solo y la clave va aparte
bot/noticias.json
bot/noticias_cache.json
noticias.json

# Lo que empuja Brio: es contenido externo y puede pesar; se regenera solo
bot/noticias_brio.json
bot/noticias_brio.json.tmp
